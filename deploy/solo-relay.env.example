# Solo Relay environment configuration.
# Install to /opt/solo-relay/solo-relay.env on the relay host.

PORT=8080
HOST=127.0.0.1
MAX_BUFFER=200
MAX_CONNS=10000
LOG_LEVEL=info
# Comma-separated CORS whitelist for browser clients.
ALLOWED_ORIGINS=https://solo.up2ai.top
# JSON-lines access log for offline analysis (DuckDB). Leave empty to disable.
# The systemd unit sets LogsDirectory=solo-relay so this path is writable.
ACCESS_LOG_PATH=/var/log/solo-relay/access.log
